deferred DapController.compute_mass_properties    -- see: Comanche055/TVCMASSPROP.agc
    -- Full or incremental mass property computation from vehicle
    -- mass and configuration. Returns IXX, IAVG, IAVG/TLX.

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.compute_roll_region    -- see: Comanche055/TVCROLLDAP.agc
    -- Phase-plane switching logic for roll DAP. Evaluates OGAERR
    -- and OGARATE against the parabolic switching curve and
    -- deadband boundaries to determine coast, fire+, or fire-.

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.compute_fire_time    -- see: Comanche055/TVCROLLDAP.agc
    -- Computes jet firing duration from roll error, rate, and
    -- 1/CONACC. Clamps to [15ms, 2.5s].

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.compute_jet_commands    -- see: Comanche055/JET_SELECTION_LOGIC.agc
    -- Phase-plane dead-band logic per axis, combined with
    -- translation hand controller inputs. Produces channel 5
    -- and channel 6 bit patterns.

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.compute_entry_guidance    -- see: Comanche055/REENTRY_CONTROL.agc
    -- Entry guidance law. Computes bank angle command from drag,
    -- range-to-go, corridor constraints and flight phase.

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.derive_body_rate    -- see: Comanche055/TVCDAPS.agc
    -- CDU rate derivation and gimbal-to-body transformation for
    -- TVC pitch/yaw loops. Applies RLIMTEST rate clamping.

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.derive_rcs_body_rate    -- see: Comanche055/RCS-CSM_DIGITAL_AUTOPILOT.agc
    -- Rate filter for RCS DAP. Derives body rates from CDU angle
    -- differences via AMBG matrix transformation.

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.apply_filter    -- see: Comanche055/TVCDAPS.agc
    -- 6th-order generalised digital filter (FWDFLTR). Operates
    -- on the six filter nodes. Coefficients loaded by TVCINIT
    -- differ between CSM-only and CSM/LM configurations.

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.zeroed_filter    -- see: Comanche055/TVCINITIALIZE.agc
    -- Returns a FilterState with all nodes zeroed (MRCLEAN).

-- allium-ignore allium.deferred.missingLocationHint
deferred DapController.zeroed_commands    -- see: Comanche055/TVCINITIALIZE.agc
    -- Returns an ActuatorCommand with all trims and offsets zeroed.

